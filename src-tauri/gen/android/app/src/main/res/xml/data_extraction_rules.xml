<?xml version="1.0" encoding="utf-8"?>
<!-- PARSEC holds wallet keys in app data (the BANKON vault). None of it may leave the phone
     through Android's cloud backup or device-to-device transfer: exclude every domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
