{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android and iOS: what a phone can use. No shell, tray, window dragging or desktop file locations.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:webview:default",
    "core:path:default",
    "core:resources:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-download-read-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-download-meta-recursive",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }],
      "deny": []
    },
    "notification:default",
    "os:default",
    "os:allow-platform",
    "os:allow-os-type",
    "os:allow-version",
    "os:allow-locale"
  ],
  "platforms": ["android", "iOS"]
}
