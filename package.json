{
  "name": "parsec-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PARSEC Wallet — Algorand desktop wallet built on cypherpunk2048 principles",
  "author": "cypherpunk2048",
  "license": "(Apache-2.0 AND GPL-3.0-or-later AND MIT)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint:css:production": "stylelint \"src/**/*.scss\" --config .stylelintrc.production.cjs",
    "lint:css:ci": "stylelint \"src/**/*.scss\" --config .stylelintrc.production.cjs --formatter compact",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:permaweb": "npm run build && cp dist/index.html dist/404.html && permaweb-deploy deploy --arns-name pythai --ario-process mainnet --deploy-folder ./dist --ttl-seconds 3600",
    "deploy:permaweb:txid": "npm run build && cp dist/index.html dist/404.html && permaweb-deploy deploy --deploy-folder ./dist",
    "build:resolver": "vite build --config apps/bankon-resolver/vite.config.ts",
    "deploy:resolver": "npm run build:resolver && cp apps/bankon-resolver/dist/index.html apps/bankon-resolver/dist/404.html && permaweb-deploy deploy --deploy-folder ./apps/bankon-resolver/dist",
    "map:arweave": "python3 scripts/arweave-map.py",
    "spawn:bnr": "tsx scripts/spawn-bnr.mjs",
    "spawn:bmr": "tsx scripts/spawn-bmr.mjs"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.0",
    "@algorandfoundation/xhd-wallet-api": "^1.0.3",
    "@ar.io/sdk": "^4.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@solana/kit": "^6.10.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@txnlab/nfd-sdk": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "algo-x-evm-sdk": "^0.1.3",
    "algosdk": "^3.0.0",
    "arweave": "^1.15.7",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "node-forge": "^1.4.0",
    "p-map": "^7.0.4",
    "p-ratelimit": "^1.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.2",
    "@types/node-forge": "^1.3.14",
    "@walletconnect/sign-client": "^2.21.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "permaweb-deploy": "3.4.6",
    "sass-embedded": "^1.89.2",
    "stylelint": "^16.21.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "npm run lint:css"
    ]
  },
  "keywords": [
    "algorand",
    "wallet",
    "tauri",
    "typescript",
    "desktop",
    "cypherpunk"
  ]
}
