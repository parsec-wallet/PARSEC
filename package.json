{
  "name": "parsec-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Parsec Wallet — Algorand desktop wallet built on cypherpunk2048 principles",
  "author": "cypherpunk2048",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint:css:production": "stylelint \"src/**/*.scss\" --config .stylelintrc.production.cjs",
    "lint:css:ci": "stylelint \"src/**/*.scss\" --config .stylelintrc.production.cjs --formatter compact",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.0",
    "@algorandfoundation/xhd-wallet-api": "^1.0.3",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@txnlab/nfd-sdk": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "algo-x-evm-sdk": "^0.1.3",
    "algosdk": "^3.0.0",
    "bip39": "^3.1.0",
    "p-map": "^7.0.4",
    "p-ratelimit": "^1.0.1"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "@tauri-apps/cli": "^2.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "sass-embedded": "^1.89.2",
    "stylelint": "^16.21.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "npm run lint:css"
    ]
  },
  "keywords": [
    "algorand",
    "wallet",
    "tauri",
    "typescript",
    "desktop",
    "cypherpunk"
  ]
}
