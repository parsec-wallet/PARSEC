# Parsec Wallet — Environment Configuration
# Vite exposes VITE_* variables to the client via import.meta.env

# "Just because" — your personal featured assets on the right side of the matrix
# Comma-separated symbols. These always appear as featured floating glyphs.
# The algorithm picks top movers from majors (BTC,ETH,AVAX,ADA,ALGO,POL,XRP,SOL,DOT)
# separately — "just because" is YOUR list, not the algorithm's.
VITE_JUST_BECAUSE=POL,ALGO,ETH,BEAM,ZIL
